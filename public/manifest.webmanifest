{
  "name": "StreakUp - Habit Tracker",
  "short_name": "StreakUp",
  "description": "Daily tasks, monthly habits, Gemini AI reports and reminders.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#4f46e5",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/day/today", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "AI Reports", "url": "/reports", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
